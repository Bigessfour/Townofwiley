    "@angular/compiler": "22.0.2",
    "@angular/core": "22.0.2",
    "@angular/forms": "22.0.2",
    "@angular/platform-browser": "22.0.2",
    "@angular/platform-server": "22.0.2",
    "@angular/router": "22.0.2",
    "@angular/service-worker": "22.0.2",
    "@angular/ssr": "22.0.3",
    "@aws-amplify/ui-angular": "^5.3.5",
    "@fontsource/fraunces": "^5.2.9",
    "@fontsource/source-sans-3": "^5.2.9",
    "@fullcalendar/angular": "^6.1.20",
    "@fullcalendar/core": "^6.1.20",
    "@fullcalendar/daygrid": "^6.1.20",
    "@primeuix/themes": "^2.0.3",
    "aws-amplify": "^6.18.0",
    "express": "^5.1.0",
    "primeicons": "^7.0.0",
    "primeng": "^21.1.9",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "22.0.3",
    "@angular/cli": "22.0.3",
    "@angular/compiler-cli": "22.0.2",
    "@angular/platform-browser-dynamic": "22.0.2",
    "@applitools/eyes-playwright": "^1.47.1",
    "@axe-core/cli": "^4.11.3",
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.61.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/express": "^5.0.1",
    "@types/node": "^24.13.1",
    "@vitest/browser-playwright": "^4.1.7",
    "@vitest/coverage-v8": "^4.1.7",
    "angular-eslint": "22.0.0",
    "eslint": "^10.3.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.61.0",
    "postcss": "^8.5.14",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.3.0",
    "tailwindcss-primeui": "^0.6.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.61.0",
    "vitest": "^4.1.7",
    "web-codegen-scorer": "^0.0.70",
    "webpack-bundle-analyzer": "^4.10.2"
