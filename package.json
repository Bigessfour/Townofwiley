{
  "name": "townofwiley-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "setup:node": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/setup-repo-node.ps1",
    "setup:node:wsl": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/setup-repo-node-wsl.ps1",
    "setup:wsl-terminal": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/setup-wsl-terminal.ps1",
    "doctor:wsl": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/doctor-wsl.ps1",
    "recover:wsl": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/recover-wsl.ps1",
    "prestart": "node scripts/ensure-node-version.mjs && npm run generate:runtime-config",
    "start": "ng serve",
    "start:polling": "node scripts/ensure-node-version.mjs && ng serve --poll=2000",
    "serve:prodlike": "npm run prestart && ng serve --configuration=production",
    "serve:4300": "npx --yes kill-port 4200 4300 && npm run prestart && ng serve --host 127.0.0.1 --port 4300",
    "prebuild": "node scripts/ensure-node-version.mjs && npm run generate:runtime-config:strict && npm run generate:cms-snapshot && node scripts/verify-public-cms-query.mjs",
    "verify:public-cms-query": "node scripts/verify-public-cms-query.mjs",
    "verify:cms-snapshot-parity": "node scripts/verify-cms-snapshot-parity.mjs",
    "cms:ensure-mayor-row": "python3 scripts/ensure-mayor-roster-row.py",
    "verify:staff-cms-editor-models": "node scripts/verify-staff-cms-editor-models.mjs",
    "deploy:gen1:sitecopy": "python scripts/deploy-gen1-sitecopy-model.py",
    "pregenerate:ai-manifest": "node scripts/prepare-ai-manifest.mjs",
    "pregenerate:ai-manifest:compact": "node scripts/prepare-ai-manifest.mjs",
    "generate:ai-manifest": "python scripts/generate-ai-manifest.py",
    "generate:ai-manifest:compact": "python scripts/generate-ai-manifest.py --compact",
    "build": "ng build",
    "postbuild": "node scripts/generate-static-route-entrypoints.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:unit": "ng test",
    "test:unit:browser": "ng test --watch=false --browsers=chromiumHeadless",
    "test:vitest": "vitest run && npm run verify:staff-cms-editor-models && npm run test:runtime-config-strict && npm run test:csp-inline-style-policy && node --test scripts/ci-gate-check.test.mjs scripts/deploy-static-site.manifest.test.mjs scripts/ollama-log-prefilter.test.mjs scripts/ollama-pr-review-prompt.test.mjs scripts/ci-failure-facts.test.mjs scripts/ollama-text.test.mjs",
    "ci:collect-improvements": "node scripts/ci-collect-ollama-improvements.mjs",
    "ci:ollama-pr-review:local": "node scripts/ollama-pr-review.mjs",
    "test:coverage": "vitest run --coverage",
    "test:vitest:watch": "vitest",
    "audit:done:local": "npm run lint && npm run verify:public-cms-query && npm run test:vitest && npm run test:coverage && npm run build && npm run test:e2e:smoke",
    "test:infra": "node --test infrastructure/nws-weather-proxy/index.test.mjs infrastructure/cms-media-upload/index.test.mjs",
    "migrate:cloudfront-oac": "python3 scripts/migrate-cloudfront-oac.py",
    "verify:aws-infra": "node scripts/ensure-node-version.mjs && node scripts/verify-aws-infrastructure.mjs",
    "configure:cloudwatch-logging": "python scripts/configure-townofwiley-cloudwatch-logging.py",
    "configure:free-tier-security": "python scripts/configure-townofwiley-free-tier-security.py",
    "verify:nws-proxy-aws": "bash scripts/verify-nws-weather-proxy-aws.sh",
    "amplify:sync-headers": "bash scripts/sync-amplify-custom-headers.sh",
    "amplify:sync-buildspec": "bash scripts/sync-amplify-buildspec.sh",
    "amplify:sync-spa-rewrites": "bash scripts/sync-amplify-spa-rules.sh",
    "amplify:sync-hosting": "npm run amplify:sync-buildspec && npm run amplify:sync-headers && npm run amplify:sync-spa-rewrites",
    "amplify:fetch-build-log": "bash scripts/fetch-amplify-build-log.sh",
    "mcp:primeng:install": "npm install --prefix mcp/primeng",
    "rag:setup": "node scripts/rag-setup.mjs",
    "rag:index": "node scripts/rag-run.mjs index",
    "rag:index:incremental": "node scripts/rag-run.mjs index-incremental",
    "rag:query": "node scripts/rag-run.mjs query",
    "rag:status": "node scripts/rag-run.mjs status",
    "xai:verify-keychain": "node scripts/verify-xai-api-key.mjs",
    "scorer:prepare-source": "node -e \"const fs=require('fs');const p=require('path');const src=p.join('node_modules','web-codegen-scorer','examples','environments','angular','project');const dest='.scorer-source';fs.rmSync(dest,{recursive:true,force:true});fs.cpSync(src,dest,{recursive:true});\"",
    "scorer:eval": "node scripts/run-web-codegen-scorer.mjs",
    "scorer:action-items": "node scripts/scorer-action-items.mjs",
    "scorer:report": "web-codegen-scorer report",
    "rag:test": "node scripts/rag-test.mjs",
    "verify:custom-http-yaml": "node scripts/verify-custom-http-yaml.mjs",
    "verify:csp-inline-style-policy": "node scripts/verify-csp-inline-style-policy.mjs",
    "test:csp-inline-style-policy": "node --test scripts/verify-csp-inline-style-policy.test.mjs",
    "sync:angular-serve-csp": "node scripts/sync-angular-serve-csp.mjs",
    "verify:live-csp-probe": "bash scripts/probe-live-hosting-csp.sh",
    "verify:live-csp-vs-repo": "node scripts/compare-live-csp-to-repo.mjs",
    "aws:configure-profile": "bash scripts/configure-aws-cli-profile.sh",
    "aws:login": "bash scripts/aws-login-town.sh steve",
    "aws:login:copilot": "bash scripts/aws-login-town.sh copilot",
    "aws:discover": "bash scripts/aws-discover-town-resources.sh",
    "aws:guestbook:discover": "bash scripts/decommission-hello-from-guestbook-aws.sh discover",
    "aws:guestbook:decommission": "bash scripts/decommission-hello-from-guestbook-aws.sh decommission",
    "terraform:guestbook:destroy": "bash scripts/terraform-destroy-guestbook.sh --auto-approve",
    "aws:iam:documents-storage": "bash scripts/apply-documents-storage-iam.sh",
    "terraform:fmt": "terraform -chdir=infrastructure/terraform fmt -recursive",
    "terraform:town:init": "terraform -chdir=infrastructure/terraform/environments/town-production init -backend-config=backend.hcl",
    "terraform:town:validate": "terraform -chdir=infrastructure/terraform/environments/town-production validate",
    "terraform:town:plan": "bash -c 'source scripts/terraform-export-aws-env.sh steve && terraform -chdir=infrastructure/terraform/environments/town-production init -input=false && terraform -chdir=infrastructure/terraform/environments/town-production plan'",
    "terraform:e2e:validate": "bash scripts/terraform-validate-town-e2e.sh",
    "test:infra:alerts": "python -m pytest infrastructure/severe-weather-signup/tests",
    "test:infra:mail": "python3 -m unittest discover -s infrastructure/email-alias-router/tests -v",
    "verify:email-alias-mime": "python3 scripts/verify-email-alias-mime-passthrough.py",
    "mail:forwarding:reforward": "python3 scripts/reforward-email-alias-mail.py",
    "test:infra:backend": "python -m pytest",
    "test:infra:monitor": "python3 -m unittest discover infrastructure/site-monitor/tests",
    "test:infra:ops": "python3 -m unittest discover -s infrastructure/ops_lib/tests -p 'test_*.py'",
    "test:infra:appsync-key-reminder": "python3 -m unittest discover infrastructure/appsync-key-rotation-reminder/tests",
    "test:infra:cms-change-notifier": "python3 -m unittest discover infrastructure/cms-change-notifier/tests",
    "test:regression": "npm run test:unit:browser && npm run test:infra && npm run test:e2e:regression && npm run test:e2e:inventory",
    "test:regression:e2e": "npm run pretest:e2e:smoke && playwright test --project=smoke-critical && playwright test e2e/specs/inventory --project=desktop-chromium --workers=2",
    "pretest:e2e": "node scripts/ensure-node-version.mjs && npx --yes kill-port 4200 4300 && node scripts/e2e-smoke-preflight.mjs",
    "pretest:e2e:smoke": "node scripts/ensure-node-version.mjs && npx --yes kill-port 4200 4300 && node scripts/e2e-smoke-preflight.mjs",
    "pretest:e2e:inventory": "node scripts/ensure-node-version.mjs && npx --yes kill-port 4200 4300 && node scripts/e2e-smoke-preflight.mjs",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:trace": "PLAYWRIGHT_TRACE=on NODE_OPTIONS='${NODE_OPTIONS:-} --trace-warnings' playwright test",
    "test:e2e:preflight": "node scripts/e2e-smoke-preflight.mjs",
    "test:e2e:smoke": "playwright test --project=smoke-critical --workers=2",
    "test:e2e:smoke:full": "playwright test e2e/specs/smoke --project=desktop-chromium --workers=2",
    "test:e2e:inventory": "playwright test e2e/specs/inventory --project=desktop-chromium --workers=2",
    "test:e2e:smoke:all-projects": "playwright test e2e/specs/smoke --workers=1",
    "test:e2e:live:staging": "playwright test e2e/specs/smoke/live-hosting.spec.ts e2e/specs/smoke/live-hosting-headers.spec.ts --project=desktop-chromium --workers=1",
    "test:e2e:live:production": "E2E_BASE_URL=https://www.townofwiley.gov/ playwright test e2e/specs/smoke/live-hosting.spec.ts e2e/specs/smoke/live-hosting-headers.spec.ts --project=desktop-chromium --workers=1",
    "test:e2e:live:csp-inline-style": "playwright test e2e/specs/smoke/live-hosting.spec.ts -g \"inline-style\" --project=desktop-chromium --workers=1",
    "test:e2e:regression": "npm run test:e2e:smoke:full && playwright test e2e/specs/accessibility e2e/specs/responsive e2e/specs/typography --project=desktop-chromium --workers=1",
    "test:e2e:snapshots": "PLAYWRIGHT_VISUAL_SNAPSHOTS=1 playwright test e2e/specs/best-practices/deterministic-coverage.spec.ts --project=desktop-chromium --workers=1",
    "test:e2e:install": "node scripts/playwright-install.mjs",
    "verify:playwright-mcp": "echo '@playwright/mcp is IDE-only (Cursor / VS Code / Grok via npx @playwright/mcp@latest per .cursor/mcp.json, docs/grok-cli.md and AGENTS.md). It is intentionally NOT a project dependency and never installed by npm ci. This check is advisory only and will not block CI.'",
    "e2e:init-agents": "playwright init-agents --loop copilot -c playwright.config.ts --prompts",
    "perf:lighthouse:staging": "npx --yes lighthouse https://staging.townofwiley.gov --only-categories=performance,accessibility --preset=desktop --quiet --chrome-flags=\"--headless=new\"",
    "generate:runtime-config": "node scripts/generate-runtime-config.mjs",
    "generate:runtime-config:strict": "node scripts/generate-runtime-config.mjs --strict",
    "test:runtime-config-strict": "node --test scripts/generate-runtime-config.strict.test.mjs",
    "verify:runtime-config-cms": "node scripts/verify-runtime-config-cms.mjs",
    "verify:no-gen2-cms": "node scripts/verify-no-gen2-cms-references.mjs",
    "verify:contact-review": "node scripts/verify-contact-review-security.mjs",
    "generate:cms-snapshot": "node scripts/generate-cms-snapshot.mjs",
    "seed:public-documents": "node scripts/seed-public-documents-from-archive.mjs",
    "configure:appsync-cache": "python scripts/configure-townofwiley-cloudwatch-logging.py --appsync-cache-only",
    "secrets:init": "node scripts/user-secrets.mjs init",
    "secrets:init:local-passphrase": "node scripts/user-secrets.mjs init --generate-passphrase",
    "secrets:status": "node scripts/user-secrets.mjs status",
    "secrets:unlock": "node scripts/user-secrets.mjs unlock",
    "secrets:lock": "node scripts/user-secrets.mjs lock",
    "secrets:lock:prune": "node scripts/user-secrets.mjs lock --prune-local",
    "secrets:prune-local": "node scripts/user-secrets.mjs prune-local",
    "secrets:export-env": "node scripts/user-secrets.mjs export-env",
    "secrets:export-runtime-env": "node scripts/user-secrets.mjs export-runtime-env",
    "secrets:import-env": "node scripts/user-secrets.mjs import-env --lock",
    "secrets:sync-runtime": "node scripts/sync-runtime-secrets.mjs",
    "pipeline:secrets": "node scripts/sync-runtime-secrets.mjs && node scripts/user-secrets.mjs lock && node scripts/generate-runtime-config.mjs --strict && node --test scripts/generate-runtime-config.strict.test.mjs",
    "pipeline:validate": "npm run lint && npm run test:vitest && npm run verify:aws-infra -- --offline",
    "deploy:email-alias-router": "python3 scripts/deploy-email-alias-router.py",
    "mail:forwarding:configure": "node scripts/configure-town-mail-forwarding.mjs",
    "mail:forwarding:deploy": "npm run verify:email-alias-mime && npm run test:infra:mail && npm run deploy:email-alias-router -- --alias-table EmailAlias-j7b2x3sh7rcezekekkxxiak7hi-main --forwarder-from clerk@townofwiley.gov --fallback-alias-address clerk@townofwiley.gov --ingress-region us-east-1 --send-region us-east-2",
    "configure:cognito-staff-email": "python scripts/configure-cognito-staff-email.py",
    "configure:cognito-hosted-ui": "python scripts/setup-cognito-hosted-ui.py",
    "reset:cognito-staff-password": "python scripts/reset-cognito-staff-password.py",
    "deploy:nws-weather-proxy": "python scripts/deploy-nws-weather-proxy.py",
    "deploy:severe-weather-backend": "python scripts/deploy-severe-weather-backend.py",
    "deploy:site-monitor": "python scripts/deploy-site-monitor.py",
    "deploy:site": "bash scripts/deploy-static-site.sh",
    "deploy:site:dry": "bash scripts/deploy-static-site.sh --dry-run",
    "deploy:static-site": "node scripts/deploy-static-site.mjs",
    "deploy:appsync-key-reminder": "python scripts/deploy-appsync-key-rotation-reminder.py",
    "deploy:cms-media-upload": "python scripts/deploy-cms-media-upload.py",
    "deploy:cms-change-notifier": "python scripts/deploy-cms-change-notifier.py",
    "deploy:appsync-waf": "python scripts/deploy-appsync-waf.py",
    "enable:cms-dynamodb-pitr": "python scripts/enable-cms-dynamodb-pitr.py",
    "schedule:appsync-key-deletion": "python scripts/schedule-appsync-key-deletion.py",
    "verify:appsync-key-deletion-schedule": "python scripts/verify-appsync-key-deletion-schedule.py",
    "assets:hero": "node scripts/convert-hero.mjs",
    "lint": "node scripts/ensure-node-version.mjs && ng lint",
    "serve:ssr:townofwiley-app": "node dist/townofwiley-app/server/server.mjs",
    "build:stats": "ng build --configuration production,stats --stats-json",
    "analyze:bundle": "webpack-bundle-analyzer dist/townofwiley-app/stats.json"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=24.15.0 <25.0.0",
    "npm": "^11.0.0"
  },
  "volta": {
    "node": "24.16.0"
  },
