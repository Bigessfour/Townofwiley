{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Town of Wiley AWS infrastructure manifest",
  "type": "object",
  "required": ["version", "accountId", "primaryRegion", "amplify", "lambdaFunctions"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "accountId": { "type": "string", "pattern": "^[0-9]{12}$" },
    "primaryRegion": { "type": "string" }
  }
}
