{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "GuestReadDocumentsObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": "arn:aws:s3:::townofwiley-documents-storage-main/*"
    },
    {
      "Sid": "GuestListDocumentsPrefix",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::townofwiley-documents-storage-main",
      "Condition": {
        "StringLike": {
          "s3:prefix": ["", "documents/", "documents/*", "public/", "public/*"]
        }
      }
    }
  ]
}
