{
  "$schema": "./aws-infrastructure.manifest.schema.json",
  "version": 1,
  "description": "Single source of truth for Town of Wiley custom AWS resources (account 570912405222). Frontend hosting: S3 townofwiley-static-site + CloudFront E1NZ3XCY5CYR1J (d34qrz3qxoppc5.cloudfront.net) with townofwiley-spa-redirect Function (June 2026 migration; old Amplify app d331voxr1fhoir deleted). Backend: AppSync/DynamoDB (current CFN stacks amplify-townofwiley-main-d1245-* and related), Lambda Function URLs (chatbot, guestbook, contact, etc.), minimal CloudWatch (1d retention), no WAF rate ACLs. Historical Amplify references retained for backend/runtime-config compatibility.",
  "accountId": "570912405222",
  "primaryRegion": "us-east-2",
  "documentation": "docs/AWS_INFRASTRUCTURE_SOT.md",
  "hosting": {
    "type": "s3-cloudfront",
    "s3Bucket": "townofwiley-static-site",
    "region": "us-east-2",
    "cloudFrontDistributionId": "E1NZ3XCY5CYR1J",
    "cloudFrontDomain": "d34qrz3qxoppc5.cloudfront.net",
    "spaRedirectFunction": "townofwiley-spa-redirect",
    "aliases": ["townofwiley.gov", "www.townofwiley.gov"],
    "acmCertArn": "arn:aws:acm:us-east-1:570912405222:certificate/a7d4c19b-070a-478b-9f3a-7203e53fcf90",
    "deployCommand": "aws s3 sync dist/townofwiley-app/browser s3://townofwiley-static-site --delete && aws cloudfront create-invalidation --distribution-id E1NZ3XCY5CYR1J --paths \"/*\""
  },
  "amplify": {
    "note": "Legacy hosting app d331voxr1fhoir DELETED June 2026 after S3+CF migration. App ID and old stack names retained here and in snapshots/inventories only for historical backend references (AppSync, document storage, runtime-config logic). Current backend stacks use 'amplify-townofwiley-main-d1245-*' naming. Sync scripts for Amplify Hosting are obsolete for production.",
    "appId": "d331voxr1fhoir",
    "appName": "Townofwiley (hosting decommissioned)",
    "productionBranch": "main (historical)",
    "nodeVersion": "24.16.0",
    "customDomain": "townofwiley.gov (now on CloudFront)",
    "syncScripts": {
      "note": "amplify:sync-* scripts for hosting headers/buildspec are historical/dev-parity only",
      "hosting": "npm run amplify:sync-hosting (no-op for prod)",
      "buildSpec": "npm run amplify:sync-buildspec (no-op for prod)",
      "headers": "npm run amplify:sync-headers (CSP now at CF level)",
      "spaRules": "npm run amplify:sync-spa-rewrites (now via CloudFront Function)"
    }
  },
  "appsync": {
    "apiName": "townofwiley-main",
    "defaultAuthorizationType": "API_KEY",
    "additionalAuthorizationTypes": ["AWS_IAM", "AMAZON_COGNITO_USER_POOLS"]
  },
  "s3Buckets": [
    {
      "name": "townofwiley-documents-storage-main",
      "region": "us-east-2",
      "purpose": "Amplify Storage branch bucket (logical name townofwiley-documents-storage)",
      "requireBlockPublicAccess": true
    },
    {
      "name": "townofwiley-email-alias-570912405222-us-east-1",
      "region": "us-east-1",
      "purpose": "SES inbound email alias storage",
      "requireBlockPublicAccess": true
    }
  ],
  "dynamodbTables": [
    {
      "name": "TownOfWileyContactUpdates",
      "region": "us-east-2",
      "required": true,
      "deployScript": "scripts/deploy-contact-update-backend.py"
    }
  ],
  "lambdaFunctions": [
    {
      "functionName": "TownOfWileyNWSWeatherProxy",
      "region": "us-east-2",
      "runtime": "nodejs",
      "codePath": "infrastructure/nws-weather-proxy",
      "functionUrl": { "authType": "NONE", "required": true },
      "functionUrlEndpoint": "https://a5wbyzz6iiawupk3xwpozdy5ji0awggh.lambda-url.us-east-2.on.aws/",
      "deployScript": "scripts/deploy-nws-weather-proxy.py",
      "required": true,
      "notes": "Handler-only CORS on Function URL (empty AllowOrigins); deploy script enforces"
    },
    {
      "functionName": "TownOfWileySevereWeatherBackend",
      "region": "us-east-2",
      "runtime": "python",
      "codePath": "infrastructure/severe-weather-signup",
      "functionUrl": { "authType": "NONE", "required": true },
      "functionUrlEndpoint": "https://myqlw4fgzf5hwnes5ki2msye2m0bbbue.lambda-url.us-east-2.on.aws",
      "deployScript": "scripts/deploy-severe-weather-backend.py",
      "required": true
    },
    {
      "functionName": "townofwiley-easy-peasy-chat-proxy",
      "region": "us-east-2",
      "runtime": "nodejs",
      "codePath": "infrastructure/easy-peasy-chat-proxy",
      "functionUrl": { "authType": "NONE", "required": true },
      "required": true
    },
    {
      "functionName": "TownOfWileyContactUpdate",
      "region": "us-east-2",
      "runtime": "nodejs",
      "codePath": "infrastructure/contact-update-lambda",
      "functionUrl": { "authType": "NONE", "required": true },
      "deployScript": "scripts/deploy-contact-update-backend.py",
      "required": false,
      "notes": "Public resident POST; pair with client sanitization (AP-06) and WAF (AP-16)"
    },
    {
      "functionName": "TownOfWileyContactUpdatesReview",
      "region": "us-east-2",
      "runtime": "nodejs",
      "codePath": "infrastructure/contact-updates-review",
      "functionUrl": { "authType": "AWS_IAM", "required": true },
      "deployScript": "scripts/deploy-contact-updates-review.py",
      "required": false,
      "notes": "Admin PII scan; must use SigV4 proxy (AP-05b/c), never public NONE"
    },
    {
      "functionName": "TownOfWileyContactUpdatesReviewProxy",
      "region": "us-east-2",
      "runtime": "nodejs",
      "codePath": "infrastructure/contact-updates-review-proxy",
      "functionUrl": { "authType": "NONE", "required": true },
      "deployScript": "scripts/deploy-contact-updates-review-proxy.py",
      "required": false,
      "notes": "Browser-facing proxy; origin-restricted; signs IAM review URL (AP-05b)"
    },
    {
      "functionName": "TownOfWileyEmailAliasRouter",
      "region": "us-east-1",
      "runtime": "python",
      "codePath": "infrastructure/email-alias-router",
      "deployScript": "scripts/deploy-email-alias-router.py",
      "required": false,
      "notes": "SES-triggered; no Function URL"
    },
    {
      "functionName": "TownOfWileyDeveloperMonitor",
      "region": "us-east-2",
      "runtime": "python",
      "codePath": "infrastructure/site-monitor",
      "deployScript": "scripts/deploy-site-monitor.py",
      "required": false,
      "notes": "EventBridge schedule; no public URL"
    },
    {
      "functionName": "TownOfWileyPaystarProxy",
      "region": "us-east-2",
      "runtime": "nodejs",
      "codePath": "infrastructure/paystar-proxy",
      "functionUrl": { "authType": "NONE", "required": false },
      "required": false,
      "notes": "Optional if Paystar API mode; hosted-only may omit Lambda"
    }
  ],
  "deploymentOrder": [
    {
      "step": 1,
      "name": "Amplify backend",
      "action": "amplify push or Amplify Studio (AppSync, Cognito, Storage)",
      "paths": ["amplify/backend/"]
    },
    {
      "step": 2,
      "name": "Amplify hosting SSOT",
      "action": "npm run amplify:sync-hosting",
      "paths": ["amplify.yml", "customHttp.yml", "scripts/amplify-spa-rewrite-rules.json"]
    },
    {
      "step": 3,
      "name": "NWS weather proxy",
      "action": "python scripts/deploy-nws-weather-proxy.py",
      "paths": ["infrastructure/nws-weather-proxy/"]
    },
    {
      "step": 4,
      "name": "Severe weather backend",
      "action": "python scripts/deploy-severe-weather-backend.py",
      "paths": ["infrastructure/severe-weather-signup/"]
    },
    {
      "step": 5,
      "name": "Email alias router",
      "action": "python scripts/deploy-email-alias-router.py",
      "paths": ["infrastructure/email-alias-router/"]
    },
    {
      "step": 6,
      "name": "Contact update write + DynamoDB",
      "action": "python scripts/deploy-contact-update-backend.py",
      "paths": ["infrastructure/contact-update-lambda/"]
    },
    {
      "step": 7,
      "name": "Contact update review (IAM URL)",
      "action": "python scripts/deploy-contact-updates-review.py",
      "paths": ["infrastructure/contact-updates-review/"]
    },
    {
      "step": 8,
      "name": "Contact update review proxy (public URL for admin UI)",
      "action": "python scripts/deploy-contact-updates-review-proxy.py",
      "paths": ["infrastructure/contact-updates-review-proxy/"]
    },
    {
      "step": 9,
      "name": "Amplify env + redeploy main",
      "action": "Set branch env vars per infrastructure/amplify-branch-env.manifest.json; redeploy main; AP-01b verify runtime-config.js",
      "paths": ["scripts/generate-runtime-config.mjs"]
    },
    {
      "step": 10,
      "name": "Verify live vs manifest",
      "action": "npm run verify:aws-infra",
      "paths": ["infrastructure/aws-infrastructure.manifest.json"]
    }
  ]
}
