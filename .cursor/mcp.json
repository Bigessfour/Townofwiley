{
  "mcpServers": {
    "angular-cli": {
      "command": "npx",
      "args": ["-y", "@angular/cli@21.2.5", "mcp", "--experimental-tool", "modernize"]
    },
    "primeng": {
      "command": "node",
      "args": ["mcp/primeng/node_modules/@primeng/mcp/dist/index.js"],
      "env": {
        "NODE_OPTIONS": "--no-deprecation"
      }
    },
    "microsoft/playwright-mcp": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest", "--config", "playwright-mcp.config.json"],
      "env": {
        "PLAYWRIGHT_BROWSERS_PATH": ".playwright-browsers"
      }
    },
    "playwright-test": {
      "command": "npx",
      "args": ["-y", "playwright", "run-test-mcp-server"],
      "env": {
        "PLAYWRIGHT_BROWSERS_PATH": ".playwright-browsers"
      }
    },
    "chrome-devtools": {
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@latest"]
    },
    "townofwiley-rag": {
      "command": "wsl",
      "args": ["bash", "-c", "cd \"$(wslpath -u '$PWD')\" && node scripts/rag-mcp.mjs"]
    }
  }
}
