{
  "mcpServers": {
    "angular-cli": {
      "command": "npx",
      "args": ["-y", "@angular/cli@21.2.5", "mcp", "--experimental-tool", "modernize"]
    },
    "primeng": {
      "command": "npx",
      "args": ["-y", "@primeng/mcp@21.1.6"]
    },
    "microsoft/playwright-mcp": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@1.59.1", "--config", "playwright-mcp.config.json"],
      "env": {
        "PLAYWRIGHT_BROWSERS_PATH": ".playwright-browsers"
      }
    },
    "playwright-test": {
      "command": "npx",
      "args": ["-y", "playwright", "run-test-mcp-server"],
      "env": {
        "PLAYWRIGHT_BROWSERS_PATH": ".playwright-browsers"
      }
    }
  }
}
