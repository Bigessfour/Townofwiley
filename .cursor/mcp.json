{
  "mcpServers": {
    "angular-cli": {
      "command": "npx",
      "args": ["-y", "@angular/cli@21.2.5", "mcp", "--experimental-tool", "modernize"]
    },
    "primeng": {
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "scripts/primeng-mcp.ps1"
      ],
      "env": {
        "NODE_OPTIONS": "--no-deprecation"
      }
    },
    "microsoft/playwright-mcp": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest", "--config", "playwright-mcp.config.json"],
      "env": {
        "PLAYWRIGHT_BROWSERS_PATH": ".playwright-browsers"
      }
    },
    "playwright-test": {
      "command": "npx",
      "args": ["-y", "playwright", "run-test-mcp-server"],
      "env": {
        "PLAYWRIGHT_BROWSERS_PATH": ".playwright-browsers"
      }
    },
    "chrome-devtools": {
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@latest"]
    },
    "townofwiley-rag": {
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "node scripts/rag-mcp.mjs"
      ]
    }
  }
}
