{
  "mcpServers": {
    "angular-cli": {
      "command": "npx",
      "args": ["-y", "@angular/cli@21.2.5", "mcp", "--experimental-tool", "modernize"]
    },
    "primeng": {
      "command": "node",
      "args": ["scripts/primeng-mcp.mjs"],
      "env": {
        "NODE_OPTIONS": "--no-deprecation"
      }
    },
    "microsoft/playwright-mcp": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest", "--config", "playwright-mcp.config.json"],
      "env": {
        "PLAYWRIGHT_BROWSERS_PATH": ".playwright-browsers"
      }
    },
    "playwright-test": {
      "command": "npx",
      "args": ["-y", "playwright", "run-test-mcp-server"],
      "env": {
        "PLAYWRIGHT_BROWSERS_PATH": ".playwright-browsers"
      }
    },
    "chrome-devtools": {
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@latest"]
    },
    "townofwiley-rag": {
      "command": "bash",
      "args": ["scripts/rag-mcp.sh"],
      "env": {
        "PATH": "/opt/homebrew/opt/node@24/bin:/usr/local/opt/node@24/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"
      }
    }
  }
}
