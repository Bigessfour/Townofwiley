{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Town Site: Launch + Debug (Chrome)",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://127.0.0.1:4300",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "serve:debug",
      "internalConsoleOptions": "openOnSessionStart",
      "skipFiles": [
        "<node_internals>/**",
        "${workspaceFolder}/node_modules/**",
        "${workspaceFolder}/.angular/cache/**",
        "**/chunk-*.js",
        "**/.angular/cache/**",
        "**/@fs/**/.angular/cache/**",
        "http://127.0.0.1:4300/@fs/**/.angular/cache/**",
        "**/vite/deps/chunk-*.js",
        "http://127.0.0.1:4300/@fs/**/vite/deps/chunk-*.js*"
      ],
      "sourceMaps": true,
      "smartStep": true,
      "resolveSourceMapLocations": ["${workspaceFolder}/**", "!**/node_modules/**"],
      "sourceMapPathOverrides": {
        "webpack:///./*": "${webRoot}/*",
        "webpack:///*": "${webRoot}/*",
        "/./*": "${webRoot}/*",
        "vite:///*": "*",
        "/@fs/*": "*"
      },
      "justMyCode": true
    },
    {
      "name": "Town Site: Attach to Running Chrome (9222)",
      "type": "pwa-chrome",
      "request": "attach",
      "port": 9222,
      "urlFilter": "http://127.0.0.1:4300/*",
      "webRoot": "${workspaceFolder}",
      "internalConsoleOptions": "openOnSessionStart",
      "skipFiles": [
        "<node_internals>/**",
        "${workspaceFolder}/node_modules/**",
        "${workspaceFolder}/.angular/cache/**",
        "**/chunk-*.js",
        "**/.angular/cache/**",
        "**/@fs/**/.angular/cache/**",
        "http://127.0.0.1:4300/@fs/**/.angular/cache/**",
        "**/vite/deps/chunk-*.js",
        "http://127.0.0.1:4300/@fs/**/vite/deps/chunk-*.js*"
      ],
      "sourceMaps": true,
      "smartStep": true,
      "resolveSourceMapLocations": ["${workspaceFolder}/**", "!**/node_modules/**"],
      "justMyCode": true
    },
    {
      "name": "Town Site: Unit Tests (Karma Debug)",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://localhost:9876/debug.html",
      "webRoot": "${workspaceFolder}",
      "internalConsoleOptions": "openOnSessionStart",
      "sourceMaps": true,
      "smartStep": true,
      "skipFiles": [
        "${workspaceFolder}/.angular/cache/**",
        "**/chunk-*.js",
        "**/.angular/cache/**",
        "**/@fs/**/.angular/cache/**",
        "http://127.0.0.1:4300/@fs/**/.angular/cache/**",
        "**/vite/deps/chunk-*.js",
        "http://127.0.0.1:4300/@fs/**/vite/deps/chunk-*.js*"
      ],
      "justMyCode": true
    },
    {
      "type": "vscode-edge-devtools.debug",
      "name": "Town Site: Edge DevTools — townofwiley.gov",
      "request": "launch",
      "url": "https://townofwiley.gov/",
      "webRoot": "${workspaceFolder}"
    },
    {
      "type": "pwa-msedge",
      "name": "Launch Microsoft Edge in headless mode",
      "request": "launch",
      "runtimeArgs": ["--headless", "--remote-debugging-port=9223"],
      "url": "https://townofwiley.gov/",
      "presentation": { "hidden": true }
    },
    {
      "type": "pwa-msedge",
      "name": "Launch Microsoft Edge",
      "request": "launch",
      "runtimeArgs": ["--remote-debugging-port=9223"],
      "url": "https://townofwiley.gov/",
      "presentation": { "hidden": true }
    },
    {
      "type": "vscode-edge-devtools.debug",
      "name": "Open Edge DevTools",
      "request": "attach",
      "url": "https://townofwiley.gov/",
      "presentation": { "hidden": true }
    },
    {
      "type": "pwa-msedge",
      "name": "Edge DevTools: Launch Microsoft Edge headless (Local 4300)",
      "request": "launch",
      "preLaunchTask": "serve:debug",
      "runtimeArgs": ["--headless", "--remote-debugging-port=9224"],
      "url": "http://127.0.0.1:4300/",
      "webRoot": "${workspaceFolder}",
      "presentation": { "hidden": true }
    },
    {
      "type": "vscode-edge-devtools.debug",
      "name": "Edge DevTools: Open DevTools (Local 4300)",
      "request": "attach",
      "url": "http://127.0.0.1:4300/",
      "webRoot": "${workspaceFolder}",
      "presentation": { "hidden": true }
    }
  ],
  "compounds": [
    {
      "name": "Town Site: Start + Debug",
      "configurations": ["Town Site: Launch + Debug (Chrome)"]
    },
    {
      "name": "Launch Edge Headless and attach DevTools",
      "configurations": ["Launch Microsoft Edge in headless mode", "Open Edge DevTools"],
      "stopAll": true
    },
    {
      "name": "Launch Edge and attach DevTools",
      "configurations": ["Launch Microsoft Edge", "Open Edge DevTools"],
      "stopAll": true
    },
    {
      "name": "Town Site: Edge DevTools — Local (4300)",
      "configurations": [
        "Edge DevTools: Launch Microsoft Edge headless (Local 4300)",
        "Edge DevTools: Open DevTools (Local 4300)"
      ],
      "stopAll": true
    }
  ]
}
